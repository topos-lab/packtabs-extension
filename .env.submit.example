# ==============================================================================
# PackTabs Extension Store Credentials Example (.env.submit.example)
#
# 使用指南：
# 1. 复制本文件并重命名为 .env.submit：
#    - PowerShell: Copy-Item .env.submit.example .env.submit
#    - Bash:       cp .env.submit.example .env.submit
# 2. 按照下方说明申请并填入各商店的 API 凭据
# 3. 运行测试预检验证：bun run submit:dry
# 4. 正式提交发布审核：bun run submit
#
# ⚠️ 安全警告：
# .env.submit 包含关键 API 私钥，已被 .gitignore 自动忽略，切勿将其提交到 Git 仓库！
# 详细图文与手把手申请教程请参见：docs/STORE_API_KEY_GUIDE.md
# ==============================================================================

# ==============================================================================
# 1. Chrome Web Store (官方推荐 API v2 服务账号鉴权)
# ==============================================================================
# API 版本（固定为 v2，使用 Google Cloud 服务账号，无过期重置问题）
CHROME_API_VERSION=v2

# PackTabs 扩展 ID（Chrome 网上应用店已发布的唯一 ID，无需修改）
CHROME_EXTENSION_ID=mpjjbfgjjbphemiklfoojlogcmjdkjjp

# Chrome 网上应用店开发者 Publisher ID（必填）
# 注意：你无需单独去创建 Publisher，你的开发者账号本身就是一个 Publisher！
# 最快获取途径：登录 Chrome 开发者控制台 (https://chrome.google.com/webstore/devconsole)
# 直接看浏览器地址栏 URL：https://chrome.google.com/webstore/devconsole/<你的_PUBLISHER_ID>
# 紧随 devconsole/ 后面的那一串 UUID 格式字符串（形如 f1e2d3c4-0000-4000-8000-a1b2c3d4e5f6）即是
CHROME_PUBLISHER_ID=your_publisher_id_here

# Google Cloud 服务账号邮箱（必填）
# 获取途径：Google Cloud Console -> IAM 与管理 -> 服务账号 (Service Accounts)
# 格式形如：packtabs-publisher@your-project-id.iam.gserviceaccount.com
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=your_service_account@your-project-id.iam.gserviceaccount.com

# Google Cloud 服务账号 RSA 私钥（必填）
# 获取途径：从下载的服务账号 JSON 密钥文件中的 "private_key" 字段提取
# 格式说明：必须保留两端的双引号，私钥中的换行请写为 \n 或直接换行粘贴
# 示例：
# CHROME_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"


# ==============================================================================
# 2. Firefox Add-ons (Mozilla AMO)
# ==============================================================================
# 扩展在 AMO 的唯一 ID（对应 wxt.config.ts 中的 gecko.id，无需修改）
FIREFOX_EXTENSION_ID=packtabs@topos-lab.github.io

# Mozilla 扩展开发者中心 JWT 凭据（必填）
# 获取途径：访问 Mozilla Add-on Developer Hub (https://addons.mozilla.org/developers/addon/api/key/)
# 点击「生成新凭据 (Generate new credentials)」即可获得 Issuer 和 Secret
FIREFOX_JWT_ISSUER=user:12345678:xxx
FIREFOX_JWT_SECRET=your_amo_jwt_secret_64_characters_here

# 发布渠道：listed（公开发布，默认）或 unlisted（自托管签名分发）
FIREFOX_CHANNEL=listed
